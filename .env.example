DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require
# Vertex AI uses Application Default Credentials (ADC), not an AI Studio API key.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_REVIEW_MODEL=gemini-2.5-flash-lite
# Candidate URLs come from whitelisted source sitemaps; Gemini Search grounding is not used.
GEMINI_DISCOVERY_MODE=sitemap
# Keep this false until billing and Vercel secrets are configured.
GEMINI_IMPORT_ENABLED=false
CRON_SECRET=use_a_random_value_with_at_least_16_characters
# Transactional email (Resend): verify the sender domain before enabling in production.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=JoeyClub <hello@yourdomain.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000
